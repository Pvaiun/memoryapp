{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memoryapp",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "memory-db",
      "database_id": "bb82e22b-e71f-4eef-9116-88d28b219349",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    // One 5-minute tick, two jobs:
    //   • Layer-1 punctual push scan (§11.4): deterministic, every tick.
    //   • Morning map rebuild (§9.1): the first tick past the 5am user-local
    //     day rollover builds the new day's map, so the user opens to a
    //     finished map instead of waiting on the Brain. Not a "0 5 * * *"
    //     entry because crons fire in UTC — the handler derives 5am from the
    //     client's reported tz offset, which follows timezones and DST.
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    // Model routing (§12): capture on Sonnet while validating the premise
    // (at ~1-3 captures/day the cheap-tier saving is negligible; drop to
    // claude-haiku-4-5 later if Sonnet proves unnecessary). Brain → top tier.
    "CAPTURE_MODEL": "claude-sonnet-5",
    "BRAIN_MODEL": "claude-opus-4-8"
  }
  // Secrets (set with `wrangler secret put <NAME>`):
  //   ANTHROPIC_API_KEY  — enables real Smart Capture + Brain (heuristic fallback without it)
  //   VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_SUBJECT — enables Web Push (§11)
}
